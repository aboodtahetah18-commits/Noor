# App
APP_ENV=development
# Optional on Vercel previews: runtime auto-detects VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL.
# Set this to the final canonical production https:// domain once assigned.
APP_BASE_URL=http://localhost:3000

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Netlify compatibility alias if underscore key is unavailable:
# DATABASEURL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Better Auth runtime security
# REQUIRED on Vercel Preview and Production. Use a strong random secret (32+ characters)
# configured in deployment environment variables. Never commit or reuse the build-only placeholder.
BETTER_AUTH_SECRET=
# Optional explicit auth/runtime origin override. Vercel deploy/branch origins are trusted automatically.
# Set this to the final canonical production https:// domain once assigned.
BETTER_AUTH_URL=http://localhost:3000

# Account email verification / password recovery
# Configure these only in deployment secrets; never commit real values.
# Production can use Resend; pilot/staging may use Gmail SMTP with an App Password.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Nama <accounts@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Restrict new registrations to auth.pilot_access while testing.
PILOT_MODE=false

# Database migration safety
# Keep false for local/preview by default. Enable only in an intentional operator/production migration context.
ALLOW_DB_MIGRATIONS=false

# Scheduler protection
CRON_SECRET=replace-with-a-long-random-cron-secret
JOB_SECRET=replace-with-a-long-random-job-secret

# Optional AI explanation layer
# Financial calculations and posting never depend on AI output.
# Financial operations remain fully usable without OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
