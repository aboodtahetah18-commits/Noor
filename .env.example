# App
APP_ENV=development
# Optional on Vercel previews: runtime auto-detects VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL.
# Set this to the final canonical production https:// domain once assigned.
APP_BASE_URL=http://localhost:3000

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Netlify compatibility alias if underscore key is unavailable:
# DATABASEURL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional explicit auth/runtime origin override. Vercel deploy/branch origins are trusted automatically.
# Set this to the final canonical production https:// domain once assigned.
BETTER_AUTH_URL=http://localhost:3000

# Database migration safety
# Keep false for local/preview by default. Enable only in an intentional operator/production migration context.
ALLOW_DB_MIGRATIONS=false

# Scheduler protection
CRON_SECRET=replace-with-a-long-random-cron-secret
JOB_SECRET=replace-with-a-long-random-job-secret

# Optional AI explanation layer
# Financial calculations and posting never depend on AI output.
# Financial operations remain fully usable without OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
