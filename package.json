{
  "name": "personal-finance-advisor",
  "version": "1.5.0",
  "private": true,
  "engines": {
    "node": "24.20.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/ensure-env-example.mjs && vitest run",
    "test:watch": "vitest",
    "check": "npm run quality:gate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "verify:security": "node scripts/verify-security-boundary.mjs",
    "verify:regression": "node scripts/verify-regression-contract.mjs",
    "regression": "npm run test && npm run verify:security && npm run verify:database-provider && npm run verify:routes && npm run verify:runtime-surface && npm run verify:regression",
    "staging:preflight": "node scripts/staging-preflight.mjs",
    "staging:secret": "node scripts/generate-secret.mjs",
    "staging:migrate": "node scripts/migrate-staging.mjs",
    "deploy:preflight": "node scripts/deployment-preflight.mjs",
    "deploy:migrate": "node scripts/migrate-deployment.mjs",
    "verify:routes": "node scripts/verify-route-integrity.mjs",
    "verify:dependencies": "node scripts/verify-dependency-policy.mjs",
    "quality:gate": "node scripts/production-quality-gate.mjs",
    "verify:eslint-config": "node scripts/verify-eslint-config.mjs",
    "ensure:env-example": "node scripts/ensure-env-example.mjs",
    "dependencies:lock": "node scripts/generate-package-lock.mjs",
    "ensure:npmrc": "node scripts/ensure-npmrc.mjs",
    "smoke:production": "node scripts/postdeploy-smoke.mjs",
    "ops:status": "node scripts/production-status.mjs",
    "ops:stability": "node scripts/production-stability.mjs",
    "ops:hardening": "node scripts/production-hardening.mjs",
    "ops:recovery-preflight": "node scripts/recovery-preflight.mjs",
    "ops:live-validate": "node scripts/live-production-validation.mjs",
    "ops:release-seal": "node scripts/final-release-seal.mjs",
    "verify:ui-token-compliance": "node scripts/verify-ui-token-compliance.mjs",
    "verify:mobile-overflow": "node scripts/verify-mobile-horizontal-overflow-contract.mjs",
    "verify:database-provider": "node scripts/verify-database-provider-policy.mjs",
    "verify:runtime-surface": "node scripts/verify-runtime-surface.mjs",
    "verify:project-contract": "node scripts/verify-project-execution-contract.mjs",
    "verify:design-system": "node scripts/verify-design-system-contract.mjs",
    "prequality:gate": "node scripts/ensure-npmrc.mjs && node scripts/ensure-env-example.mjs",
    "verify:interactions": "node scripts/verify-interaction-capabilities-contract.mjs",
    "vercel:build": "npm run vercel:preflight && npm run quality:gate",
    "vercel:migrate": "node scripts/migrate-deployment.mjs",
    "vercel:preflight": "node scripts/vercel-preflight.mjs",
    "verify:vercel": "node scripts/verify-vercel-deployment-contract.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.0.1",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.44.5",
    "next": "16.3.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "drizzle-kit": "0.31.4",
    "eslint": "9.34.0",
    "eslint-config-next": "16.3.3",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "vitest": "4.1.0"
  },
  "packageManager": "npm@11.19.0"
}
