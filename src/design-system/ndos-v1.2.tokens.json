  "typography": {
    "family": "Noto Sans Arabic",
    "h1": {
      "size": 30,
      "range": "28-32",
      "weight": 700
    },
    "h2": {
      "size": 23,
      "range": "22-24",
      "weight": 700
    },
    "h3": {
      "size": 19,
      "range": "18-20",
      "weight": 700
    },
    "body": {
      "size": 15,
      "range": "14-16",
      "weight": 400
    },
    "small": {
      "size": 12,
      "weight": 400
    },
    "caption": {
      "size": 11,
      "weight": 400
    },
    "kpi": {
      "size": 32,
      "range": "28-36",
      "weight": 700
    }
  },
  "spacing": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48,
    64
  ],
  "radius": {
    "xs": 6,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "xxl": 24,
    "pill": 999
  },
  "button_height": {
    "sm": 32,
    "md": 40,
    "lg": 48
  },
  "desktop": {
    "system_sidebar": {
      "expanded": "240-272",
      "collapsed": "72-80"
    },
    "header": "64-72"
  },
  "chat": {
    "composer": "48-56",
    "user_max_width": "76%",
    "mobile_chat_viewport": "85-90%"
