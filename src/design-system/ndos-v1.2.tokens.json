{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "product": "نماء | Namaa",
    "system": "Namaa Design Operating System",
    "version": "1.2 FINAL",
    "date": "2026-09-15",
    "rtl_first": true,
    "light_first": true,
    "mobile_experience": "responsive_full_platform",
    "desktop_experience": "full_workspace_with_optional_chat",
    "identity_status": "FROZEN"
  },
  "color": {
    "brand.green.900": "#0B6B4F",
    "brand.green.700": "#189F7F",
    "brand.gold.500": "#D4AF6B",
    "brand.gold.action": "#FCAA30",
    "surface.cream": "#FFF7E6",
    "surface.warm": "#FAF9F4",
    "surface.card": "#FFFFFF",
    "surface.chat.canvas": "#F6F4ED",
    "surface.chat.user": "#DDF3E8",
    "surface.chat.agent": "#FFFFFF",
    "text.primary": "#1F2937",
    "text.muted": "#61758A",
    "border.default": "#DCE6E0",
    "border.strong": "#C9D8D1",
    "state.info": "#3882F6",
    "state.warning": "#F59E0B",
    "state.danger": "#EF4444",
    "state.success": "#189F7F"
